{
  "$comment": "meteor-cfd - Copyright (c) 2026 주식회사 이터레이션즈 (Iterations Co., Ltd.). Source-available, not Open Source. No GPL-licensed source was consulted.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-iteration/1",
  "title": "one iteration row",
  "description": "One row of iterations.jsonl, docs/16 §D S10; it has no timestamp and no duration on purpose, so an interrupted and an uninterrupted run write byte-identical rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
      "schema",
      "study_id",
      "n",
      "eval_key",
      "params_sha",
      "template_id",
      "template_sha",
      "requirements_lock",
      "gates_lock",
      "env_sha",
      "level",
      "origin",
      "stage_reached",
      "solve_class",
      "design_verdict",
      "n_hard_pass",
      "n_hard_fail",
      "n_hard_ne",
      "objective",
      "objective_u",
      "verdict_sha",
      "cache_hit"
    ],
  "properties": {
      "schema": {"const": "cad-iteration/1"},
      "study_id": {"$ref": "#/$defs/StudyId"},
      "n": {"type": "integer", "minimum": 0},
      "eval_key": {"$ref": "#/$defs/Sha"},
      "params_sha": {"$ref": "#/$defs/Sha"},
      "template_id": {"$ref": "#/$defs/TemplateId"},
      "template_sha": {"$ref": "#/$defs/Sha"},
      "requirements_lock": {"$ref": "#/$defs/Sha"},
      "gates_lock": {"$ref": "#/$defs/Sha"},
      "env_sha": {"$ref": "#/$defs/Sha"},
      "level": {"$ref": "#/$defs/Level"},
      "origin": {"enum": ["start", "init_design", "optimiser", "llm_edit", "confirmation"]},
      "stage_reached": {"enum": ["build", "checks", "readiness", "mesh", "case", "solve", "post", "judge"]},
      "solve_class": {"enum": ["steady", "unsteady", "diverged", "refused", "not_run"]},
      "design_verdict": {"enum": ["feasible", "infeasible", "not_evaluable"]},
      "n_hard_pass": {"type": "integer", "minimum": 0},
      "n_hard_fail": {"type": "integer", "minimum": 0},
      "n_hard_ne": {"type": "integer", "minimum": 0},
      "objective": {"type": ["number", "null"]},
      "objective_u": {"type": ["number", "null"], "minimum": 0},
      "verdict_sha": {"$ref": "#/$defs/ShaOrNull"},
      "cache_hit": {"type": "boolean"}
    },
  "$defs": {
      "StudyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
      "Sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "TemplateId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}/[1-9][0-9]*$"},
      "Level": {"type": "string", "pattern": "^L[0-9]$"},
      "ShaOrNull": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
    }
}
