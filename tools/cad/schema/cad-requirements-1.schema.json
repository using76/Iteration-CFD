{
  "$comment": "meteor-cfd - Copyright (c) 2026 주식회사 이터레이션즈 (Iterations Co., Ltd.). Source-available, not Open Source. No GPL-licensed source was consulted.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-requirements/1",
  "title": "the approved, locked requirement set",
  "description": "The approved, locked requirement set of docs/16 §E.1; exactly one of the three flow fields is non-null, and lock_sha is the sha256 of the document's canonical JSON with lock_sha set to null; both are enforced by reqs.py, not the schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
      "schema",
      "study_id",
      "template_id",
      "template_sha",
      "brief_sha",
      "attachments",
      "operating_point",
      "rows",
      "objective",
      "created_by",
      "approved_by",
      "lock_sha"
    ],
  "properties": {
      "schema": {"const": "cad-requirements/1"},
      "study_id": {"$ref": "#/$defs/StudyId"},
      "template_id": {"$ref": "#/$defs/TemplateId"},
      "template_sha": {"$ref": "#/$defs/Sha"},
      "brief_sha": {"$ref": "#/$defs/Sha"},
      "attachments": {"type": "array", "items": {"$ref": "#/$defs/Sha"}, "maxItems": 4},
      "operating_point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fluid", "T_K", "p0_Pa", "U_exit_m_s", "Q_m3_s", "mdot_kg_s"],
          "properties": {
              "fluid": {"enum": ["air", "water"]},
              "T_K": {"type": "number", "exclusiveMinimum": 0},
              "p0_Pa": {"type": "number", "exclusiveMinimum": 0},
              "U_exit_m_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "Q_m3_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "mdot_kg_s": {"type": ["number", "null"], "exclusiveMinimum": 0}
            }
        },
      "rows": {
          "type": "array",
          "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                  "id",
                  "ears",
                  "quantity",
                  "feature",
                  "op",
                  "value",
                  "upper",
                  "tol_abs",
                  "tol_rel",
                  "unit",
                  "kind",
                  "method",
                  "condition",
                  "hardness",
                  "source",
                  "quote",
                  "locks_params"
                ],
              "properties": {
                  "id": {"$ref": "#/$defs/ReqId"},
                  "ears": {"type": "string", "minLength": 1},
                  "quantity": {"$ref": "#/$defs/Name"},
                  "feature": {"$ref": "#/$defs/NameOrNull"},
                  "op": {"$ref": "#/$defs/Op"},
                  "value": {"type": ["number", "null"]},
                  "upper": {"type": ["number", "null"]},
                  "tol_abs": {"type": ["number", "null"], "minimum": 0},
                  "tol_rel": {"type": ["number", "null"], "minimum": 0},
                  "unit": {"$ref": "#/$defs/Unit"},
                  "kind": {"enum": ["geometric", "readiness", "performance"]},
                  "method": {"enum": ["geometry", "mesh", "cfd", "human"]},
                  "condition": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["Re", "level"],
                      "properties": {
                          "Re": {"type": ["number", "null"], "exclusiveMinimum": 0},
                          "level": {"$ref": "#/$defs/LevelOrNull"}
                        }
                    },
                  "hardness": {"$ref": "#/$defs/Hardness"},
                  "source": {"enum": ["brief", "sketch_label", "default", "assumed", "system"]},
                  "quote": {"type": ["string", "null"]},
                  "locks_params": {"type": "array", "items": {"$ref": "#/$defs/Name"}}
                }
            },
          "minItems": 1
        },
      "objective": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["quantity", "sense"],
          "properties": {"quantity": {"$ref": "#/$defs/Name"}, "sense": {"enum": ["min", "max"]}}
        },
      "created_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model"],
          "properties": {
              "provider": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1}
            }
        },
      "approved_by": {"type": "string", "minLength": 1},
      "lock_sha": {"$ref": "#/$defs/ShaOrNull"}
    },
  "$defs": {
      "StudyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
      "TemplateId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}/[1-9][0-9]*$"},
      "Sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "ReqId": {"type": "string", "pattern": "^(REQ-[0-9]{3}|SYS-[A-Z]+)$"},
      "NameOrNull": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
      "Name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
      "Op": {"enum": ["<=", ">=", "==", "in", "is_true"]},
      "Unit": {"enum": ["m", "m2", "m3", "rad", "m/s", "m3/s", "kg/s", "Pa", "K", "1"]},
      "LevelOrNull": {"type": ["string", "null"], "pattern": "^L[0-9]$"},
      "Hardness": {"enum": ["hard", "soft", "objective"]},
      "ShaOrNull": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
    }
}
