{
  "$comment": "meteor-cfd - Copyright (c) 2026 주식회사 이터레이션즈 (Iterations Co., Ltd.). Source-available, not Open Source. No GPL-licensed source was consulted.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-probe/1",
  "title": "the CAD-01 validator probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "kind",
    "count",
    "ratio",
    "tags",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "cad-probe/1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "kind": {
      "enum": [
        "nozzle",
        "pipe",
        "diffuser"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "ratio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "tags": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Row"
      }
    }
  },
  "$defs": {
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      }
    }
  }
}
