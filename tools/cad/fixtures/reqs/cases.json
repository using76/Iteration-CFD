  "briefs": {
    "B1": {"schema": "cad-brief/1", "text": "Design an axisymmetric contraction nozzle for air at 20 °C. The inlet diameter is 60 mm and the contraction ratio is 9:1. Keep the total length at most 80 mm, the wall thickness at least 2 mm, and the wall slope below 35 deg. The flow rate is 7.07 L/s. Make it as short as possible. A thick wall is welcome. An old note asked for a total length of at least 90 mm. The contraction itself must be at most 20 mm long.", "attachments": [], "provider": "anthropic"},
    "B2": {"schema": "cad-brief/1", "text": "A water contraction: 7.07 kg/s of water enters a 60 mm inlet with a contraction ratio of 9.", "attachments": [], "provider": "anthropic"},
    "B3": {"schema": "cad-brief/1", "text": "Air leaves the 20 mm exit at 22.5 m/s; the inlet is 60 mm across.", "attachments": [], "provider": "anthropic"},
    "B4": {"schema": "cad-brief/1", "text": "Build the nozzle in the sketch for 7.07 L/s of air.", "attachments": [{"sha256": "c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3", "labels": ["D 60 mm", "CR 9"]}], "provider": "anthropic"},
    "B5": {"schema": "cad-brief/1", "text": "Inlet 60 mm, contraction ratio 9, contraction between 50 and 70 mm long, 7.07 L/s of air.", "attachments": [], "provider": "anthropic"},
    "B6": {"schema": "cad-brief/1", "text": "Inlet 60 mm, contraction ratio 9; the exit diameter must stay between 19.9 mm and 20.1 mm; 7.07 L/s.", "attachments": [], "provider": "anthropic"},
    "B7": {"schema": "cad-brief/1", "text": "Inlet 60 mm, contraction ratio 9, contraction length 60 mm within 1 %, wall slope at most 0.6 rad at mesh level L1; make the wall as thick as possible; 7.07 L/s.", "attachments": [], "provider": "anthropic"},
    "B8": {"schema": "cad-brief/1", "text": "Inlet diameter 60 mm, contraction ratio 9, wall slope under 30°.", "attachments": [], "provider": "anthropic"}
  },
