{
  "$comment": "meteor-cfd - Copyright (c) 2026 주식회사 이터레이션즈 (Iterations Co., Ltd.). Source-available, not Open Source. No GPL-licensed source was consulted.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iterations.invalid/autonomy/gate_constants.schema.json",
  "title": "GateConstants",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$comment": {"type": "string"},
    "schema": {"const": "autonomy-gates/1"},
    "pinned_frac_max": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "p99_residual_over_hf_max": {"type": "number", "exclusiveMinimum": 0},
    "max_residual_over_hf_max": {"type": "number", "exclusiveMinimum": 0},
    "area_ratio_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "area_ratio_max": {"type": "number", "minimum": 1},
    "attempts_k": {"type": "integer", "minimum": 1, "maximum": 16},
    "cell_budget": {"type": "integer", "minimum": 1},
    "delivered_min_layers": {"type": "integer", "minimum": 1, "maximum": 100},
    "yplus_max_a_priori": {"type": "number", "exclusiveMinimum": 0},
    "adopted": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {"type": "string", "minLength": 1}
  },
  "required": ["$comment", "schema", "pinned_frac_max", "p99_residual_over_hf_max",
               "max_residual_over_hf_max", "area_ratio_min", "area_ratio_max",
               "attempts_k", "cell_budget", "delivered_min_layers", "yplus_max_a_priori",
               "adopted", "source"]
}
