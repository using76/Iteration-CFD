{
  "$comment": "meteor-cfd - Copyright (c) 2026 주식회사 이터레이션즈 (Iterations Co., Ltd.). Source-available, not Open Source. No GPL-licensed source was consulted.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iterations.invalid/autonomy/attempt_row.schema.json",
  "title": "AttemptRow",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "autonomy-attempt/1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["tuning", "test", "reported"]},
    "geometry_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "fingerprint": {"$ref": "fingerprint.schema.json"},
    "attempt": {"type": "integer", "minimum": 1},
    "stage_focus": {"type": ["string", "null"],
                    "enum": ["octree", "castellate", "snap", "split", "layers", null]},
    "config_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_delta": {"type": "array",
                     "items": {"$ref": "decision_record.schema.json#/$defs/Edit"}},
    "decided_by": {"enum": ["default", "rule", "remedy", "prior", "optimiser", "llm"]},
    "rule_id": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"},
    "trigger": {"$ref": "decision_record.schema.json#/$defs/Trigger"},
    "prediction": {"$ref": "#/$defs/Prediction"},
    "constraint_refusals": {"type": "array",
                            "items": {"$ref": "decision_record.schema.json"}},
    "outcome": {"$ref": "#/$defs/Outcome"},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "binary_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "t_start": {"type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "t_end": {"type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
  },
  "required": ["schema", "campaign_id", "split", "geometry_id", "fingerprint", "attempt",
               "stage_focus", "config_sha", "config_delta", "decided_by", "rule_id",
               "trigger", "prediction", "constraint_refusals", "outcome", "content_sha256",
               "binary_sha", "git_sha", "t_start", "t_end"],
  "$defs": {
    "Prediction": {
      "title": "Prediction",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "p_fail": {"type": "number", "minimum": 0, "maximum": 1},
        "p_fail_std": {"type": "number", "minimum": 0},
        "blc8_a_priori": {"type": "number", "minimum": 0, "maximum": 1},
        "log_cells": {"type": "number"},
        "t_predicted": {"type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
      },
      "required": ["p_fail", "p_fail_std", "blc8_a_priori", "log_cells", "t_predicted"]
    },
    "Outcome": {
      "title": "Outcome",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["pass", "fail"]},
        "failure_class": {"type": ["string", "null"],
          "pattern": "^(config|surface_closed|gate_G[1-7]@(octree|castellate|snap|split|layers)|layer_t1_G5|layer_dropped:(min_thickness|retreat_snapped|no_full_stack)|timeout|crash|io)$"},
        "flags": {"$ref": "#/$defs/Flags"},
        "failure": {"type": "boolean"},
        "strict_failure": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]},
        "last_stage": {"type": ["string", "null"],
                       "enum": ["octree", "castellate", "snap", "split", "layers", null]},
        "n_cells": {"type": ["integer", "null"], "minimum": 0},
        "seconds": {"type": "number", "minimum": 0},
        "pinned_frac": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "p99_over_hf": {"type": ["number", "null"], "minimum": 0},
        "max_over_hf": {"type": ["number", "null"], "minimum": 0},
        "feature_capture": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "blc8_a_priori": {"type": "number", "minimum": 0, "maximum": 1},
        "blc_full_a_priori": {"type": "number", "minimum": 0, "maximum": 1},
        "patches": {"type": "array", "items": {"$ref": "#/$defs/PatchOutcome"}},
        "h_f_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "n_pinned": {"type": ["integer", "null"], "minimum": 0},
        "n_boundary_points": {"type": ["integer", "null"], "minimum": 0},
        "refusal_line": {"type": ["string", "null"]},
        "blc_beta_a_priori": {"type": "array", "items": {"$ref": "#/$defs/BetaBound"}},
        "missing_signals": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["verdict", "failure_class", "flags", "failure", "strict_failure",
                   "exit_code", "last_stage", "n_cells", "seconds", "pinned_frac",
                   "p99_over_hf", "max_over_hf", "blc8_a_priori", "blc_full_a_priori",
                   "patches", "h_f_m", "n_pinned", "n_boundary_points", "refusal_line",
                   "blc_beta_a_priori", "missing_signals"]
    },
    "BetaBound": {
      "title": "BetaBound",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beta": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "lo": {"type": "number", "minimum": 0, "maximum": 1},
        "hi": {"type": "number", "minimum": 0, "maximum": 1},
        "exact": {"type": "boolean"}
      },
      "required": ["beta", "lo", "hi", "exact"]
    },
    "Flags": {
      "title": "Flags",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "F1": {"type": "boolean"},
        "F2": {"type": "boolean"},
        "F3a": {"type": "boolean"},
        "F3b": {"type": "boolean"},
        "F3c": {"type": "boolean"},
        "F3d": {"type": ["boolean", "null"]},
        "F3e": {"type": ["boolean", "null"]},
        "F4": {"type": "boolean"},
        "F5": {"type": "boolean"}
      },
      "required": ["F1", "F2", "F3a", "F3b", "F3c", "F3d", "F4", "F5"]
    },
    "PatchOutcome": {
      "title": "PatchOutcome",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "area_m2": {"type": "number", "minimum": 0},
        "requested": {"type": "boolean"},
        "n_layers": {"type": "integer", "minimum": 0},
        "dropped": {"type": ["string", "null"]},
        "full_area_frac": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "t1_requested_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "yplus_a_priori": {"type": ["number", "null"], "minimum": 0},
        "delivered": {"type": "boolean"},
        "capability_limited": {"type": "boolean"},
        "layer_class": {"type": ["string", "null"],
                        "enum": ["min_thickness", "retreat_snapped", "no_full_stack", null]},
        "mean_frac": {"type": ["number", "null"], "minimum": 0},
        "t1_min_m": {"type": ["number", "null"], "minimum": 0}
      },
      "required": ["name", "area_m2", "requested", "n_layers", "dropped",
                   "full_area_frac", "t1_requested_m", "yplus_a_priori", "delivered",
                   "capability_limited", "layer_class", "mean_frac", "t1_min_m"]
    }
  }
}
