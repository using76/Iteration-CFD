{
  "$comment": "meteor-cfd - Copyright (c) 2026 주식회사 이터레이션즈 (Iterations Co., Ltd.). Source-available, not Open Source. No GPL-licensed source was consulted.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iterations.invalid/autonomy/fingerprint.schema.json",
  "title": "Fingerprint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "autonomy-fingerprint/1"},
    "geometry_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "stl_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "n_triangles": {"type": "integer", "minimum": 4},
    "feature_angle_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
    "patches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/PatchArea"}},
    "area_m2": {"type": "number", "exclusiveMinimum": 0},
    "volume_m3": {"type": "number", "exclusiveMinimum": 0},
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
    "sharp_edge_length_m": {"type": "number", "minimum": 0},
    "curvature_radius_p5_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "curvature_radius_p50_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "curvature_radius_p95_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "inner_thickness_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "outer_gap_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "planar_frac": {"type": "number", "minimum": 0, "maximum": 1},
    "commensurate": {"type": "boolean"},
    "lattice_base_size_m": {"type": ["number", "null"], "exclusiveMinimum": 0}
  },
  "required": ["schema", "geometry_id", "stl_sha256", "n_triangles", "feature_angle_deg",
               "patches", "area_m2", "volume_m3", "bbox", "sharp_edge_length_m",
               "curvature_radius_p5_m", "curvature_radius_p50_m", "curvature_radius_p95_m",
               "inner_thickness_m", "outer_gap_m", "planar_frac", "commensurate",
               "lattice_base_size_m"],
  "$defs": {
    "PatchArea": {
      "title": "PatchArea",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "area_m2": {"type": "number", "minimum": 0}
      },
      "required": ["name", "area_m2"]
    }
  }
}
