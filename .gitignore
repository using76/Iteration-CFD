# ---------------------------------------------------------------- build ----
rust/target/
third_party/
__pycache__/
*.pyc

# ------------------------------------------------------------ reference ----
# FDS (NIST, public domain). Cloned separately for reference; 191 MB and not
# part of what meteor-cfd distributes. See NOTICE.
reference/

# ---------------------------------------------------------------- cases ----
# Every case here is GENERATED by `ofgpu-generate-mesh`, and the meshes and
# results run to hundreds of megabytes. Regenerate rather than clone:
#
#   cargo run --release --bin ofgpu-generate-mesh -- channel  ../cases/channel  200 120 1
#   cargo run --release --bin ofgpu-generate-mesh -- cavity   ../cases/cavity    80  80 1
#   cargo run --release --bin ofgpu-generate-mesh -- damBreak ../cases/damBreak  60 100 1
#
cases/*
!cases/README.md

# ------------------------------------------------------------- results -----
*.png
*.mp4
