// SPEC-LIT 110.4 Gate 110-C, LEG 2 (docs/17 VAL-54) - the same hot-gas plume
// as cases/plumeMcCaffrey.jsonc (leg 1, VAL-53), with a participating medium:
// P1 radiation (SPEC-LIT 135.7, 137.8) in ofgpu-lowmach. Everything leg 1
// states holds here unchanged - the box, the burner window, the declared
// Q = 57.5 kW at U_in = 2.3985 m/s (110.4's enthalpy balance), the k-epsilon
// model, the numerics - except the three inputs below, each a stated input,
// not a result:
//
// (1) radiation: P1, a grey constant absorption coefficient kappa = 1.0 1/m,
//     no scattering. The gas of a hot-gas inlet is air, which has no
//     absorption coefficient of its own, so kappa is SIZED, not a property:
//     on leg 1's own recorded fields (VAL-53, 4 000 iterations) the
//     optically thin emission  I = sum 4 sigma (T^4 - T_inf^4) V  is
//     13 397 / 15 681 / 18 543 W per (1/m) at 0.10 / 0.05 / 0.025 m, so the
//     kappa at which kappa I = 0.30 Q - the midpoint of McCaffrey's 20-40 %
//     radiant fraction (110.4) - is 1.29 / 1.10 / 0.93 1/m; 1.0 is that value
//     rounded, fixed BEFORE any radiating run. The run's own radiant
//     fraction (the radiation line's wall-and-open power L over Q) is the
//     measurement, printed beside 20-40 %.
// (2) the five walls state T fixedValue 293.15 K (leg 1: zeroGradient).
//     SPEC-LIT 137.8: an adiabatic radiating wall is balanced - the radiation
//     it receives is handed back to the gas by conduction, so no radiant
//     power could leave the box - and the balanced wall's explicit lag
//     diverges when the radiative conductance dwarfs the conductive one
//     (137.8's REVIEW-LATER). A stated wall is black at T_inf: what the
//     plume radiates to the room is lost, as in the report's open lab.
// (3) the inlet and the outlet are named in radiation.open at Tinf
//     293.15 K: black at ambient, so the burner window adds no radiant power
//     and all of Q still enters as enthalpy (the declared Q is unchanged).
//
// The mesh sequence and the recipe are 110.5's for leg 1: cells
// [33,33,40] / [66,66,80] / [132,132,160], THIS FILE IS THE 66 LEVEL, the
// other two on scratch copies with ONLY "cells" edited; ofgpu-lowmach
// -iters 4000 -check 500; ofgpu-sample column <copy> 4000 z 0 0 -at
// 1.25,1.5,1.75,2.0,2.25,2.5. The gate is validate_gates/plume_rad.rs, which
// replays the record through leg 1's bands (P1-P4, unchanged).
// ============================================================================
{
  "$schema": "https://meteor-cfd.msimul.com/schema/case-1.json",
  "name": "plumeMcCaffreyRad",

  "mesh": {
    "kind": "cartesian",
    "bounds": { "min": [-1.65, -1.65, 0.0], "max": [1.65, 1.65, 4.0] },
    "cells":  [66, 66, 80],

    // `wallXMin/wallXMax/wallYMin/wallYMax/floor/outlet`, the block's own
    // `-x +x -y +y -z +z` slot order - the top boundary is the open one here,
    // and the box is the McCaffrey case's own 3.3 x 3.3 x 4 m (110.4).
    "boundaries": {
      "xmin": "wallXMin", "xmax": "wallXMax",
      "ymin": "wallYMin", "ymax": "wallYMax",
      "zmin": "floor",    "zmax": "outlet",
    },

    // The hot inlet: a 0.30 m x 0.30 m window centred on the origin, cut from
    // the floor - the report's "0.30 m square porous refractory burner"
    // (110.4). At this level's 0.05 m cells it is 6 x 6 whole cells
    // (i 30..35, j 30..35), 0.09 m2 exactly, and no cell centre lies within
    // 0.0125 m of the edge +-0.15 - which is why the bounds are +-1.65, not
    // +-1.5 (110.4's rounding argument, and this header's).
    "regions": [
      {
        "name": "inlet",
        "on": "zmin",
        "shape": { "kind": "box", "min": [-0.15, -0.15, -1], "max": [0.15, 0.15, 1] },
      },
    ],
  },

  "physics": {
    "gravity": [0, 0, -9.81],
    "fluid": { "nu": 1.5e-5, "Pr": 0.71, "Prt": 0.85, "TRef": 293.15 },
    "buoyancy": "densityRatio",
  },

  "turbulence": {
    "kind": "RAS",
    "model": "kEpsilon",
    // `cases/plumeB/constant/momentumTransport` sets neither `kappa` nor `E`
    // (and `blended` is not read by anything - see the comment where ofgpu's
    // `TextOut::real` precision was raised, and `WallFunctionCoeffs::default`
    // itself), so these ARE `WallFunctionCoeffs::default()`'s own numbers,
    // written explicitly rather than left to a default this reader has no
    // "case gave nothing" branch for.
    "wallFunctions": { "kappa": 0.41, "E": 9.8 },
  },

  // ORDERED, first-match-wins. Three rules are enough because every patch
  // NAME is already unique (`inlet`, `outlet`, and five walls) - the
  // catch-all is a pattern-reuse convenience, not a preset: every field it
  // sets is still the literal value `cases/plumeB`'s field files carry on
  // `ceiling`/`floor`/`wallXMin`/`wallYMin`/`wallYMax` (all five are
  // identical, being ordinary no-slip, adiabatic, wall-function walls).
  "patches": [
    {
      "match": "inlet",
      "kind": "inlet",
      // 2.3985 m/s: Q = 57.5 kW, the largest of the report's five fires,
      // declared through 110.4's enthalpy balance - see this file's header.
      "U": { "type": "fixedValue", "value": [0, 0, 2.3985] },
      "p": { "type": "zeroGradient" },
      "T": { "type": "fixedValue", "value": 1173.15 },
      "k": { "type": "fixedValue", "value": 0.015 },
      "epsilon": { "type": "fixedValue", "value": 0.00361829 },
      "omega": { "type": "fixedValue", "value": 2.68022 },
      "nut": { "type": "calculated", "value": 0 },
    },
    {
      "match": "outlet",
      "kind": "open",
      "U": { "type": "inletOutlet", "inletValue": [0, 0, 0] },
      "p": { "type": "fixedValue", "value": 0.0 },
      "T": { "type": "inletOutlet", "inletValue": 293.15 },
      "k": { "type": "zeroGradient" },
      "epsilon": { "type": "zeroGradient" },
      "omega": { "type": "zeroGradient" },
      "nut": { "type": "calculated", "value": 0 },
    },
    {
      "match": ".*",
      "kind": "wall",
      "U": { "type": "fixedValue", "value": [0, 0, 0] },
      "p": { "type": "zeroGradient" },
      // Leg 2's input (2): stated at T_inf, so the wall is not balanced (137.8).
      "T": { "type": "fixedValue", "value": 293.15 },
      "k": { "type": "kqRWallFunction", "value": 0.015 },
      "epsilon": { "type": "epsilonWallFunction", "value": 0.00361829 },
      "omega": { "type": "omegaWallFunction", "value": 2.68022 },
      "nut": { "type": "nutkWallFunction", "value": 0 },
    },
  ],

  "initial": {
    "U": [0, 0, 0],
    "T": 293.15,
    "p": 0.0,
    "k": 0.015,
    "epsilon": 0.00361829,
    "omega": 2.68022,
    "nut": 0,
  },

  // Leg 2's inputs (1) and (3): see this file's header.
  "radiation": {
    "model": "P1",
    "absorption": { "model": "constant", "kappa": 1.0 },
    "open": {
      "inlet": { "Tinf": 293.15 },
      "outlet": { "Tinf": 293.15 },
    },
  },

  "numerics": {
    "algorithm": { "kind": "SIMPLE" },
    "ddt": "steadyState",
    "div": {
      // Never actually consulted: every equation this case runs names its
      // own entry below. A real, always-parseable scheme rather than
      // OpenFOAM's `none` sentinel, because `parse_div` (correctly) refuses
      // `none` as a scheme - see `numerics.div.default`'s doc in `case_json.rs`.
      "default": "Gauss upwind",
      "div(phi,U)": "Gauss linearUpwind grad(U)",
      "div(phi,T)": "bounded Gauss upwind",
      "div(phi,k)": "bounded Gauss upwind",
      "div(phi,epsilon)": "bounded Gauss upwind",
      "div(phi,omega)": "bounded Gauss upwind",
    },
    "grad": "Gauss linear",
    "laplacian": { "snGrad": "corrected", "nonOrthogonalCorrectors": 0 },
    "relaxation": { "U": 0.7, "p": 0.3, "T": 0.7, "k": 0.7, "epsilon": 0.7, "omega": 0.7 },
    "solvers": [
      { "match": "p",       "solver": "PBiCGStab", "preconditioner": "DIC",      "tolerance": 1e-8, "relTol": 0.01, "maxIter": 1000 },
      { "match": "U",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-8, "relTol": 0.1,  "maxIter": 200 },
      { "match": "T",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-8, "relTol": 0.01, "maxIter": 200 },
      { "match": "k",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-8, "relTol": 0.01, "maxIter": 200 },
      { "match": "epsilon", "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-8, "relTol": 0.01, "maxIter": 200 },
      { "match": "G",       "solver": "PCG",       "preconditioner": "DIC",      "tolerance": 1e-8, "relTol": 0.01, "maxIter": 1000 },
      { "match": "omega",   "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-8, "relTol": 0.01, "maxIter": 200 },
    ],
  },

  "run": {
    "endTime": 1.0,
    "deltaT": 1.0,
    "adjustTimeStep": false,
  },
}
