// meteor-cfd case - SPEC-LIT S32's redesigned gate, mesh (b): the SAME
// streamwise-cyclic duct as `channelPeriodicFluxWF.jsonc` (identical
// cross-section, streamwise length, momentum source, q_w, compensating
// sink), wall-normal mesh GRADED two-sided toward both hot walls
// (`mesh.grading`, 50 cells, `expansion: 200`) so the first cell sits near
// y+ ~ 1 - `lowRe`, a resolved sublayer.
//
// ============================================================================
// STATUS: CANNOT converge - kept as the regression that will pass once a
// low-Reynolds-number RAS model exists. Do not delete it; do not calibrate
// it into passing.
//
// docs/07-fire-solver.md S1.1 has the full trace. Short version, three steps:
//
//   1. Switching the model to kOmega made it WORSE (k -> 942 m2/s2), so the
//      model FAMILY is not the cause.
//   2. This is a DUCT: the `wallSide.*` patches have only 4 spanwise cells
//      and are not resolved, yet the case-wide `lowRe` preset told the
//      solver to apply NO wall model there. The `"treatment": "standard"`
//      override below (SPEC-LIT S29.1 route b) fixes exactly that - side-wall
//      k fell from 4125-y+ nonsense to 5.85 m2/s2.
//   3. Even with the side walls corrected, the HOT walls (still `lowRe`,
//      correctly - they ARE the resolved sublayer this mesh exists to
//      provide) blow k up to 160 m2/s2 at y+ 1.4-6.4. That is the real cause:
//      standard k-epsilon is a HIGH-REYNOLDS-NUMBER model with no near-wall
//      damping function, invalid below y+ ~ 30 whatever the mesh does. The
//      variant that would fix it, `LaunderSharmaKE`, is registered but not
//      implemented (`models::registry::RECOGNISED_NOT_IMPLEMENTED`).
//
// `crate::io::case::validate_low_re_wall_treatment` (SPEC-LIT S32's second
// finding) now catches this BEFORE the solver ever runs: `wallTreatment
// lowRe` under `kEpsilon` (or `kOmega`/`kOmegaSST`) is refused with a S13.4
// error naming the model, rather than left to blow up silently at run time.
// Running this case as shipped therefore fails FAST with that error, which
// is the intended, loud outcome - not a regression in the harness. Add
// `-permissive` to see it actually run (and diverge, per the trace above);
// the case becomes runnable-and-correct only once a low-Re model is
// implemented and named here.
// ============================================================================
//
// The only physical difference from `channelPeriodicFluxWF.jsonc` is the
// mesh and the `lowRe` wallTreatment; q_w = 500 W/m2 and the -6.4 W sink are
// IDENTICAL - see that file's own header for both derivations. SPEC-LIT
// S29.3: "lowRe... pins the molecular resistance the resolved mesh already
// provides", so the hot walls here are `fixedFluxTemperature` with the SAME
// q - not `thermalWallFunction` - because BcKind::FixedFluxTemperature reads
// `k_eff_wall` off whatever `crate::energy::Energy::update_k_eff` computed at
// that face, and on a `lowRe` wall (`nu_t,w = 0` pinned) that is the
// molecular conductivity alone: no Jayatilleke correction is invoked, or
// needed, because the resolved sublayer supplies its own resistance exactly
// as SPEC-LIT S32.2 asks (see `docs/07-fire-solver.md` S1.1 for the measured
// numbers and the verdict).
{
  "$schema": "https://meteor-cfd.msimul.com/schema/case-1.json",
  "name": "channelPeriodicFluxLowRe",

  "mesh": {
    "kind": "cartesian",
    "bounds": { "min": [0.0, 0.0, 0.0], "max": [0.08, 0.04, 0.04] },
    "cells":  [8, 50, 4],

    "boundaries": {
      "xmin": "streamwiseMin", "xmax": "streamwiseMax",
      "ymin": "wallHot0", "ymax": "wallHot1",
      "zmin": "wallSideMin", "zmax": "wallSideMax",
    },

    "cyclic": [ { "a": "streamwiseMin", "b": "streamwiseMax", "transform": "translate" } ],

    "grading": { "y": { "expansion": 200.0, "twoSided": true } },
  },

  "physics": {
    "gravity": [0, 0, 0],
    "fluid": { "nu": 1.5e-5, "Pr": 0.71, "Prt": 0.85, "TRef": 293.15 },
    "buoyancy": "densityRatio",
  },

  "turbulence": {
    "kind": "RAS",
    "model": "kEpsilon",
    "wallFunctions": { "kappa": 0.41, "E": 9.8 },
    "wallTreatment": "lowRe",
  },

  "sources": [
    { "type": "momentumSource", "field": "U", "bodyForce": [3.9, 0, 0] },
  ],

  "patches": [
    {
      // The z-direction side walls have only 4 spanwise cells - not a
      // resolved sublayer, whatever the case-wide `lowRe` default says. The
      // case-wide default applies NO wall model there by construction
      // (SPEC-LIT S29.1's `lowRe` row), which on an under-resolved patch is
      // a contradiction, not a preference - so this patch overrides back to
      // `standard` (SPEC-LIT S29.1 route b), the row this mesh actually
      // supports here. This alone is not enough to make the case converge
      // (see the file header) - the hot walls' own `lowRe` is correct, and
      // still exposes the missing low-Re model.
      "match": "wallSide.*",
      "kind": "wall",
      "treatment": "standard",
      "U": { "type": "fixedValue", "value": [0, 0, 0] },
      "p": { "type": "zeroGradient" },
      "T": { "type": "zeroGradient" },
    },
    {
      // Same q_w as `channelPeriodicFluxWF.jsonc` - see that file's header
      // and this file's own for why `fixedFluxTemperature` (not
      // `thermalWallFunction`) is correct on a `lowRe` wall.
      "match": "wallHot.*",
      "kind": "wall",
      "U": { "type": "fixedValue", "value": [0, 0, 0] },
      "p": { "type": "zeroGradient" },
      "T": { "type": "fixedFluxTemperature", "q": 500.0 },
    },
    {
      "match": ".*",
      "kind": "wall",
      "U": { "type": "fixedValue", "value": [0, 0, 0] },
      "p": { "type": "zeroGradient" },
      "T": { "type": "zeroGradient" },
    },
  ],

  "initial": {
    "U": [3.0, 0, 0],
    "T": 293.15,
    "p": 0.0,
    "k": 0.03,
    "epsilon": 0.3,
    "nut": 0,
  },

  "numerics": {
    "algorithm": { "kind": "SIMPLE" },
    "ddt": "steadyState",
    "div": {
      "default": "Gauss upwind",
      "div(phi,U)": "Gauss linearUpwind grad(U)",
      "div(phi,T)": "bounded Gauss upwind",
      "div(phi,k)": "bounded Gauss upwind",
      "div(phi,epsilon)": "bounded Gauss upwind",
    },
    "grad": "Gauss linear",
    "laplacian": { "snGrad": "corrected", "nonOrthogonalCorrectors": 0 },
    "relaxation": { "U": 0.5, "p": 0.3, "T": 0.5, "k": 0.5, "epsilon": 0.5 },
    "solvers": [
      { "match": "p",       "solver": "PBiCGStab", "preconditioner": "DIC",      "tolerance": 1e-9, "relTol": 0.01, "maxIter": 1000 },
      { "match": "U",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.1,  "maxIter": 200 },
      { "match": "T",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.01, "maxIter": 200 },
      { "match": "k",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.01, "maxIter": 200 },
      { "match": "epsilon", "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.01, "maxIter": 200 },
    ],
  },

  "run": {
    "endTime": 1.0,
    "deltaT": 1.0,
    "adjustTimeStep": false,
  },
}
