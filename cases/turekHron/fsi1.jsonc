// meteor-cfd case skeleton - the Turek & Hron FSI1 benchmark.
//
// S. Turek & J. Hron, "Proposal for numerical benchmarking of fluid-structure
// interaction between an elastic object and laminar incompressible flow",
// LNCSE 53, Springer (2006) 371-385, DOI 10.1007/3-540-34596-5_15, the FSI1
// row: rho^s = 1000, nu^s = 0.4, mu^s = 0.5e6 (E = 2 mu (1+nu) = 1.4e6),
// Ubar = 0.2 m/s, Re = 20, g = 0, and "FSI1 is resulting in a steady state
// solution". Reference, their finest level 7+0 (1015808 elements), m and N
// per unit depth: ux(A) = 2.270493e-05, uy(A) = 8.208773e-04,
// drag = 1.429426e+01, lift = 7.637460e-01 at A = (0.6, 0.2).
//
// SKELETON - no driver reads this file yet: S9 lands `mechanics`, S10
// `mesh.polyMesh`, S11 `mesh.regions`, S15 `ofgpu-fsi` and the parabolic
// inlet with its ramp; keys marked `S15` are invented here as that unit's
// planned shape and are refused by `deny_unknown_fields` until it lands;
// every other key is S9 C1 / S10 / S11 / dieStack verbatim.
//
// The mesh beside this file is regenerated, not kept:
//   python tools/mesh/examples/turek_hron.py --level 1
{
  "name": "turekHron_fsi1",
  "mesh": { "regions": "mesh/regions.json" },                     // S11, R8; level 1's default --out
  "regions": [
    { "name": "fluid", "kind": "fluid",
      // nu = mu/rho = 1.0e-3 m^2/s, Ubar = 0.2 m/s, Re = 20 (Turek & Hron 2006, FSI1). cp/kappa absent:
      // the case is isothermal (S15 decides whether the CHT reader's cp/kappa are demanded here).
      "fluid": { "rho": 1000.0, "mu": 1.0 },
      "patches": [                                                  // docs/case-example.json shape
        { "match": "inlet", "kind": "inlet",
          // v(0,y) = 1.5 Ubar y (H - y) / (H/2)^2 = 1.5 Ubar (4.0/0.1681) y (0.41 - y);
          // ramp v(t,0,y) = v(0,y) (1 - cos(pi t / 2)) / 2 for t < 2.0, v(0,y) otherwise.
          "U": { "type": "parabolic", "mean": 0.2, "across": "y", "from": 0.0, "to": 0.41,   // S15
                 "direction": [1, 0, 0], "ramp": { "kind": "cosine", "until": 2.0 } },        // S15
          "p": { "type": "zeroGradient" } },
        { "match": "outlet", "kind": "open", "p": { "type": "fixedValue", "value": 0.0 } },
        { "match": "(empty_front|empty_back)", "kind": "empty" },
        { "match": "(wall_top|wall_bottom|cylinder)", "kind": "wall" }
        // fluid_to_flap is NOT listed: interfaces[] owns it (dieStack omits its interface patches too)
      ] },
    { "name": "flap", "kind": "solid",
      "material": { "rho": 1000.0 },        // S9 C4 row 5: the thermal material.rho IS the region's
                                            // density; c/kappa absent (isothermal) - S15 says if demanded
      "mechanics": {                        // S9 C1, verbatim shape
        "material": { "E": 1.4e6, "nu": 0.4, "alpha": 0.0 },   // E = 2 mu (1+nu), mu = 0.5e6; no TRef
                                                               // because alpha == 0 (S9 C4 rows 3-4)
        "patches": [                        // every non-empty patch of the region exactly once (C4 row 11);
                                            // empty_front/empty_back are NOT named (an empty patch named is refused)
          { "match": "flap_fixed",    "u": { "type": "fixedDisplacement", "value": [0.0, 0.0, 0.0] } },
          { "match": "flap_to_fluid", "u": { "type": "free" } }   // S15 replaces this with the coupled traction
        ],
        "solver": { "tolerance": 1e-6, "maxOuter": 500, "relaxation": 1.0 }   // S9's defaults, spelled out
      } }
  ],
  "interfaces": [ { "regionA": "fluid", "patchA": "fluid_to_flap", "regionB": "flap", "patchB": "flap_to_fluid" } ],
  // S11 C6 step 4: the manifest lists the same pair; the case's entry wins and the duplicate is skipped.
  "coupling": { "kind": "partitioned", "acceleration": "aitken", "tolerance": 1e-6, "maxIterations": 50 },   // S15
  "initial": { "U": [0, 0, 0], "p": 0.0 },
  "run": { "steady": true, "mode": "stress" },   // S9 C1's mode; S9 C4 row 14 refuses it beside a fluid region
                                                 // until S15 lifts that row or names its own mode (S15)
  "reference": { "source": "Turek & Hron 2006, FSI1, level 7+0 (1015808 el)", "point_A": [0.6, 0.2],
                 "ux_A": 2.270493e-05, "uy_A": 8.208773e-04, "drag": 1.429426e+01, "lift": 7.637460e-01 }
}
