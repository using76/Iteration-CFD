// ============================================================================
// RERUN (SPEC-LIT S13.4.1): every number below was measured by a driver that
// read none of this file's `numerics` block. Rerun on the fixed driver,
// `-iters 6000`: y+ at the hot walls 21.95/37.76/40.31 (was 21.95/37.90/
// 40.29), total wall heat input 157.035 W, T_b = 308.039 K,
// U_b = 3.00469 m/s, |U| residual 9.4e-10. The y+ this file exists to place
// in the 30-60 band did not move. NOTE that this case's RESOLVED twin,
// `retired/channelThermalLowRe.jsonc`, no longer runs at all (see its own header),
// so the wall-heat RATIO this pair was built to produce cannot be remeasured
// - the retired 0.381 stands as a pre-S33, pre-S13.4.1 record and nothing
// more. This whole fixed-T attempt is superseded by
// `cases/channelPeriodicFluxWF.jsonc` (SPEC-LIT S32).
// ============================================================================
//
// meteor-cfd case - SPEC-LIT S29.3/S30.3's deferred thermal-wall-function
// gate, mesh (a): a plane channel/duct, inlet-driven, hot top and bottom
// walls at Tw = 373.15 K against a 293.15 K inflow, gravity zero (forced
// convection only - no buoyancy in this comparison). The mesh is uniform and
// coarse in the wall-normal direction so the first cell sits near y+ ~ 30 -
// the STANDARD wallTreatment row, i.e. the Jayatilleke `thermalWallFunction`
// correction (SPEC-LIT S29.3) actually has to do its job (no grading is
// needed here - a wall FUNCTION mesh deliberately does not resolve the
// sublayer, unlike `retired/channelThermalLowRe.jsonc` below). Side (z) walls are
// explicit `zeroGradient` on T - adiabatic, so every watt the domain gains
// comes from the two hot walls and nowhere else.
//
// Duct length is 2.0 m - L/Dh = 50 (Dh = 0.04 m, the square duct's hydraulic
// diameter), five times the 0.4 m / L/Dh = 10 of the first attempt at this
// gate (see `docs/07-fire-solver.md` S1.1's history), chosen so the
// thermal/momentum boundary layers are closer to fully developed by
// mid-channel - JSONC has no cyclic-patch support yet (`blockgen`'s own
// `case_block_spec` notes cyclics "need a coupled patch pair" it does not
// build from this format), so a longer duct is the honest substitute for a
// periodic one, not a periodic domain itself.
//
// `retired/channelThermalLowRe.jsonc` is the same duct, wall-normal mesh GRADED
// (SPEC-LIT S29/S30's grading gap, closed by Task G.1's `mesh.grading`) to
// y+ ~ 1 and the hot walls switched to plain `fixedValue` (SPEC-LIT S29.3:
// "lowRe... pins the molecular resistance the resolved mesh already
// provides and needs no correction for" - a resolved sublayer wants the
// PLAIN Robin condition, not the log-law correction). Run both through
// `ofgpu-fire`, steady, and compare the wall heat transferred - see
// `docs/07-fire-solver.md` S1.1 for the measured numbers and what the ratio
// says.
{
  "$schema": "https://meteor-cfd.msimul.com/schema/case-1.json",
  "name": "channelThermalWF",

  "mesh": {
    "kind": "cartesian",
    "bounds": { "min": [0.0, 0.0, 0.0], "max": [2.0, 0.04, 0.04] },
    "cells":  [200, 6, 4],

    "boundaries": {
      "xmin": "inlet", "xmax": "outlet",
      "ymin": "wallHot0", "ymax": "wallHot1",
      "zmin": "wallSideMin", "zmax": "wallSideMax",
    },
  },

  "physics": {
    "gravity": [0, 0, 0],
    "fluid": { "nu": 1.5e-5, "Pr": 0.71, "Prt": 0.85, "TRef": 293.15 },
    "buoyancy": "densityRatio",
  },

  "turbulence": {
    "kind": "RAS",
    "model": "kEpsilon",
    "wallFunctions": { "kappa": 0.41, "E": 9.8 },
    "wallTreatment": "standard",
  },

  "patches": [
    {
      "match": "inlet",
      "kind": "inlet",
      "U": { "type": "fixedValue", "value": [3.0, 0, 0] },
      "p": { "type": "zeroGradient" },
      "T": { "type": "fixedValue", "value": 293.15 },
      "k": { "type": "fixedValue", "value": 0.03 },
      "epsilon": { "type": "fixedValue", "value": 0.3 },
      "nut": { "type": "calculated", "value": 0 },
    },
    {
      "match": "outlet",
      "kind": "open",
      "U": { "type": "inletOutlet", "inletValue": [0, 0, 0] },
      "p": { "type": "fixedValue", "value": 0.0 },
      "T": { "type": "inletOutlet", "inletValue": 293.15 },
      "k": { "type": "zeroGradient" },
      "epsilon": { "type": "zeroGradient" },
      "nut": { "type": "calculated", "value": 0 },
    },
    {
      // Spanwise (z) walls: adiabatic on purpose, explicit, so the two
      // wallTreatment rows differ ONLY in how they treat the hot walls -
      // not in an incidental side-wall heat leak.
      "match": "wallSide.*",
      "kind": "wall",
      "U": { "type": "fixedValue", "value": [0, 0, 0] },
      "p": { "type": "zeroGradient" },
      "T": { "type": "zeroGradient" },
    },
    {
      // The hot walls - SPEC-LIT S29.3's `thermalWallFunction`, named
      // explicitly with its own Tw (highest precedence, S29.1's table),
      // since the case-level `wallTreatment` auto-completion has no wall
      // temperature of its own to write (see `ScalarBc::ThermalWallFunction`'s
      // own doc). nut/k/epsilon are left to the `standard` row.
      "match": "wallHot.*",
      "kind": "wall",
      "U": { "type": "fixedValue", "value": [0, 0, 0] },
      "p": { "type": "zeroGradient" },
      "T": { "type": "thermalWallFunction", "value": 373.15 },
    },
  ],

  "initial": {
    "U": [0, 0, 0],
    "T": 293.15,
    "p": 0.0,
    "k": 0.03,
    "epsilon": 0.3,
    "nut": 0,
  },

  "numerics": {
    "algorithm": { "kind": "SIMPLE" },
    "ddt": "steadyState",
    "div": {
      "default": "Gauss upwind",
      "div(phi,U)": "Gauss linearUpwind grad(U)",
      "div(phi,T)": "bounded Gauss upwind",
      "div(phi,k)": "bounded Gauss upwind",
      "div(phi,epsilon)": "bounded Gauss upwind",
    },
    "grad": "Gauss linear",
    "laplacian": { "snGrad": "corrected", "nonOrthogonalCorrectors": 0 },
    "relaxation": { "U": 0.5, "p": 0.3, "T": 0.5, "k": 0.5, "epsilon": 0.5 },
    "solvers": [
      { "match": "p",       "solver": "PBiCGStab", "preconditioner": "DIC",      "tolerance": 1e-9, "relTol": 0.01, "maxIter": 1000 },
      { "match": "U",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.1,  "maxIter": 200 },
      { "match": "T",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.01, "maxIter": 200 },
      { "match": "k",       "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.01, "maxIter": 200 },
      { "match": "epsilon", "solver": "PBiCGStab", "preconditioner": "diagonal", "tolerance": 1e-9, "relTol": 0.01, "maxIter": 200 },
    ],
  },

  // Unused by `ofgpu-fire` in steady mode (no `-endTime`/`-deltaT` given on
  // the command line) - present because the schema requires it.
  "run": {
    "endTime": 1.0,
    "deltaT": 1.0,
    "adjustTimeStep": false,
  },
}
