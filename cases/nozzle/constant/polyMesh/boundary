FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    inlet
    {
        type            patch;
        nFaces          1;
        startFace       199;
    }
    outlet
    {
        type            patch;
        nFaces          1;
        startFace       200;
    }
    walls
    {
        type            symmetry;
        nFaces          400;
        startFace       201;
    }
    frontAndBack
    {
        type            symmetry;
        nFaces          400;
        startFace       601;
    }
)

