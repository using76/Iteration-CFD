# Iteration CFD Studio — server configuration (copy to gui/.env or export in the shell)

# Claude API key (server only). Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Model for the assistant (default claude-opus-5).
# CFD_MODEL=claude-opus-5

# Demo mode: never spawn the real solver; a mock solver writes realistic logs and
# result files, and the assistant is a scripted mock unless an API key is set.
# CFD_DEMO=1

# Force the LLM client: anthropic | zai | mock
# CFD_LLM=anthropic

# z.ai (GLM) alternative: the server talks to z.ai's Anthropic-compatible
# endpoint instead of the Anthropic API. The key is read from ZAI_API_KEY or
# from the file CFD_ZAI_KEY_FILE (one line, default ~/.claude/zai-key).
# CFD_LLM=zai
# ZAI_API_KEY=
# CFD_ZAI_KEY_FILE=~/.claude/zai-key
# Override the endpoint (default https://api.z.ai/api/anthropic).
# CFD_LLM_BASE_URL=
# Thinking budget in tokens (default 4096) and the max_tokens cap (default 64000).
# CFD_ZAI_THINKING_TOKENS=4096
# CFD_ZAI_MAX_TOKENS=64000
# With CFD_LLM=zai the default model is glm-5.3-flash.
# CFD_MODEL=glm-5.3-flash

# Start without an API key (uses the mock LLM).
# CFD_ALLOW_NO_API_KEY=1

# Where the ofgpu-* binaries live (Windows: the folder holding ofgpu-k-epsilon.exe ...).
# Falls back to rust/target/release, then `cargo run --release --bin` when nvcc is on PATH.
# OFGPU_BIN_DIR=C:\Iteration-CFD\rust\target\release

# Workspace root every file/case path is confined to (default: the repository root).
# CFD_WORKSPACE=

# Server bind address/port (default 127.0.0.1:8787).
# CFD_HOST=127.0.0.1
# CFD_PORT=8787

# Mock solver speed multiplier (1 = a 4000-iteration run takes ~45 s).
# CFD_MOCK_SPEED=1

# Allow non-loopback clients (requires CFD_AUTH_TOKEN).
# CFD_ALLOW_REMOTE=0
# CFD_AUTH_TOKEN=
