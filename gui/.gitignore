node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Runtime state written under gui/ itself. Anchored with a leading slash: an
# unanchored `runs/` also matches server/src/runs/, which is source, and git
# silently drops it from every commit.
/runs/
/sessions/
/.cache/
/test-results/
/playwright-report/
/e2e/screenshots/
/config/custom-tools.json
/config/policy.local.json

# The ontology mirror (N2): a SQLite file rebuilt from the repo by the importer,
# plus the WAL sidecars that exist only while a process holds it open. The
# definitions themselves are TypeScript under shared/src/ontology/ and ARE committed,
# and a future MIGRATIONS/*.sql must stay committable - so ignore the files, not the directory.
/ontology/*.db
/ontology/*.db-wal
/ontology/*.db-shm
